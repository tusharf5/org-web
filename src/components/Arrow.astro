---
interface Props {
  direction?: 'up-right' | 'down' | 'right';
  class?: string;
}

const { direction = 'up-right', class: className = '' } = Astro.props;
---

<svg
  class:list={['arrow', `arrow--${direction}`, className]}
  width="20"
  height="20"
  viewBox="0 0 24 24"
  fill="none"
  aria-hidden="true"
>
  <path d="M6 18 18 6M6 6h12v12" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
</svg>
